{
  "id": "/",
  "name": "DocPrime PDF",
  "short_name": "DocPrime",
  "description": "Premium PDF-Suite direkt im Browser: zusammenfügen, trennen, signieren, konvertieren.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0B0F19",
  "theme_color": "#0B0F19",
  "orientation": "any",
  "scope": "/",
  "lang": "de",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/tools/edit",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "DocPrime PDF Übersicht im Browser"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "752x1344",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "DocPrime PDF Editor auf dem Smartphone"
    }
  ],
  "shortcuts": [
    {
      "name": "PDF Bearbeiten",
      "short_name": "Bearbeiten",
      "description": "PDFs direkt im Browser bearbeiten",
      "url": "/tools/edit",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "PDF Komprimieren",
      "short_name": "Komprimieren",
      "description": "PDF-Dateien verkleinern",
      "url": "/tools/compress",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "PDF Zusammenfügen",
      "short_name": "Zusammenfügen",
      "description": "Mehrere PDFs zusammenfügen",
      "url": "/tools/merge",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "handle_links": "preferred"
}
